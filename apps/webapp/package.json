{
  "name": "@radio/webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx ../../scripts/buildStationPages.mts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "generate-catalog": "node update-catalog.js",
    "test:e2e:ci": "playwright test --workers=1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.26",
    "d3-geo": "^3.1.1",
    "hls.js": "^1.5.16",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^25.0.1",
    "node-fetch": "^2.7.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
