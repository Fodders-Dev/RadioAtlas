{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/lib/shuffleStations.ts"
  ],
  "concurrency": 1,
  "tempDirName": "../../.tmp/quality-experiments/stryker-sandbox",
  "ignorePatterns": [
    "**/.env",
    "**/.env.*",
    "../../apps/api/data/**",
    "public/**",
    "tests/**",
    "dist/**",
    "acceptance-artifacts/**",
    "../../.tmp/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "incremental": false,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "../../.tmp/quality-experiments/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "../../.tmp/quality-experiments/mutation/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 80,
    "break": 0
  }
}
