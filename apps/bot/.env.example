BOT_TOKEN=
WEBAPP_URL=
# Canonical API base. Avoid redirected aliases here: a 301 can turn the bot's
# POST /internal/bot/ai-chat into GET and force the warm fallback.
API_URL=https://radioatlas.ru/api
WEBAPP_DEEPLINK=
AI_ENABLED=0
# Shared secret for the bot -> API billing webhook handshake.
# Must match apps/api INTERNAL_WEBHOOK_TOKEN exactly. Generate with:
#   openssl rand -hex 32
INTERNAL_WEBHOOK_TOKEN=
# Where users are directed if billing webhook forward fails (T0.2b
# apology copy). Defaults to @ahjkuio if unset. Switch to
# @radioatlas_support once that account is live.
SUPPORT_HANDLE=@ahjkuio
