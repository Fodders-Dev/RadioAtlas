PORT=3001
PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=
# Shared secret for the bot -> API billing webhook handshake.
# Must match apps/bot INTERNAL_WEBHOOK_TOKEN exactly. Generate with:
#   openssl rand -hex 32
INTERNAL_WEBHOOK_TOKEN=
# Comma-separated allow-list of origins permitted to read the API
# cross-origin (exact match, case-insensitive on scheme+host).
# REQUIRED in production - the process exits non-zero on boot if
# NODE_ENV=production and this is empty. In dev it falls back to
# localhost:5173/5174 + 127.0.0.1:5173/5174.
# Production recommended value:
#   ALLOWED_ORIGINS=https://radioatlas.ru,https://www.radioatlas.ru,https://radioatlas.duckdns.org,https://web.telegram.org,https://k.telegram.org,https://a.telegram.org,https://z.telegram.org
#   (radioatlas.ru is the primary domain; radioatlas.duckdns.org kept as a dual-served fallback.)
ALLOWED_ORIGINS=
# Set to "production" on every production deploy; gates ALLOWED_ORIGINS
# requirement above and any future production-only guards.
NODE_ENV=
ACCOUNT_STORE_PATH=
RADIO_BROWSER_URLS=
CATALOG_FETCH_TIMEOUT_MS=8000
STREAM_PROXY_TIMEOUT_MS=8000
METADATA_PROBE_TIMEOUT_MS=5000
METADATA_STREAM_TIMEOUT_MS=7000
METADATA_NEGATIVE_CACHE_TTL_MS=5000
FETCH_CACHE_TTL_MS=5000
FETCH_NEGATIVE_CACHE_TTL_MS=2500
MEDIA_RATE_LIMIT_WINDOW_MS=60000
METADATA_RATE_LIMIT_PER_WINDOW=120
FETCH_RATE_LIMIT_PER_WINDOW=180
MEDIA_SHARED_CONCURRENCY=8
METADATA_CONCURRENCY=4
FETCH_CONCURRENCY=6
FETCH_RESPONSE_LIMIT_BYTES=262144
OBSERVABILITY_ALERT_WEBHOOK=
OBSERVABILITY_STORE_PATH=
