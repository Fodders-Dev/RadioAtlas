{
  "name": "radio-plusplus-tg",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:webapp": "npm --workspace apps/webapp run dev",
    "dev:bot": "npm --workspace apps/bot run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "catalog:update": "node scripts/updateCatalog.mjs",
    "artwork:generate": "node scripts/generateScenePack.mjs",
    "geo:check": "node scripts/checkGeoFallback.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:test": "npm run typecheck:test --workspaces",
    "test:webapp": "npm --workspace apps/webapp run test:e2e",
    "test:api": "npm --workspace apps/api run test",
    "test:bot": "npm --workspace apps/bot run test",
    "test:scripts": "node --test scripts/generateScenePack.test.mjs deploy/server/s3put.test.mjs",
    "eval:lira": "npm --workspace apps/api run eval:lira --",
    "test": "npm run typecheck && npm run typecheck:test && npm run test:api && npm run test:bot && npm run test:scripts && npm run test:webapp"
  }
}
